#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

plugin_repository="manikandakumar/personal-plugins"
plugin_checkout="$HOME/.cache/amp/repositories/manikandakumar-personal-plugins"
plugin_source="$plugin_checkout/.amp/plugins"
plugin_directory="$HOME/.config/amp/plugins"

echo "[setup] Installing personal Amp plugins"
mkdir -p "$(dirname "$plugin_checkout")" "$plugin_directory"
if [[ -d "$plugin_checkout/.git" ]]; then
  git -C "$plugin_checkout" pull --ff-only
else
  amp clone "$plugin_repository" "$plugin_checkout"
fi

while IFS= read -r -d '' link; do
  target="$(readlink "$link")"
  if [[ "$target" == "$plugin_source/"* && ! -e "$link" ]]; then
    rm -- "$link"
  fi
done < <(find "$plugin_directory" -maxdepth 1 -type l -print0)

while IFS= read -r -d '' plugin; do
  destination="$plugin_directory/$(basename "$plugin")"
  if [[ (-e "$destination" || -L "$destination") &&
        (! -L "$destination" || "$(readlink "$destination")" != "$plugin") ]]; then
    echo "[setup] Refusing to replace existing plugin: $destination" >&2
    exit 1
  fi
  ln -sfn -- "$plugin" "$destination"
done < <(find "$plugin_source" -maxdepth 1 -type f \( -name '*.ts' -o -name '*.js' \) -print0)

echo "[setup] Checking Python 3.11+"
python3 - <<'PY'
import sys

if sys.version_info < (3, 11):
    raise SystemExit("Python 3.11 or newer is required")
PY

if ! command -v bwrap >/dev/null 2>&1; then
  echo "[setup] Installing Bubblewrap sandbox runtime"
  if [[ "$(id -u)" -eq 0 ]]; then
    apt-get update -qq
    apt-get install -y bubblewrap
  else
    sudo apt-get update -qq
    sudo apt-get install -y bubblewrap
  fi
fi

echo "[setup] Verifying Bubblewrap user/network/PID namespace isolation"
bwrap --unshare-user --unshare-pid --unshare-net --unshare-ipc --unshare-uts \
  --unshare-cgroup --ro-bind /usr /usr --symlink usr/lib /lib \
  --symlink usr/lib64 /lib64 --proc /proc --dev /dev --tmpfs /tmp \
  --clearenv /usr/bin/true

if [[ -f pyproject.toml ]]; then
  echo "[setup] Creating the project virtual environment"
  python3 -m venv .venv

  echo "[setup] Installing project and development dependencies"
  if [[ -f uv.lock ]] && command -v uv >/dev/null 2>&1; then
    uv sync --frozen --all-extras
  else
    .venv/bin/python -m pip install --disable-pip-version-check --upgrade pip
    .venv/bin/python -m pip install --disable-pip-version-check -e '.[dev]'
  fi
else
  echo "[setup] No pyproject.toml yet; no project dependencies to install"
fi

echo "[setup] Complete"
